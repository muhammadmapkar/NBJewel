# Backend-only settings for the AI service. Copy to .env and fill in locally.
# Never commit a real key. Pick GEMINI_MODEL from https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional. How much the model thinks before answering: minimal, low, medium or high. Lower is faster. Default: low.
GEMINI_THINKING_LEVEL=low
NBJEWEL_API_URL=http://localhost:5155
