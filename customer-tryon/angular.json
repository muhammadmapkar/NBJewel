{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "customer-tryon": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ct",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "**/*", "input": "node_modules/@mediapipe/tasks-vision/wasm", "output": "mediapipe/wasm" }
            ],
            "styles": ["src/styles.css"],
            "outputPath": "dist/customer-tryon"
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "buildTarget": "customer-tryon:build" }
        }
      }
    }
  },
  "cli": { "analytics": false }
}
