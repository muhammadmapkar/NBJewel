{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "nbjewel-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "nb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "node_modules/@mediapipe/tasks-vision/wasm", "output": "mediapipe/wasm" }
            ],
            "styles": ["src/styles.css"],
            "allowedCommonJsDependencies": ["qrcode"],
            "outputPath": "dist/nbjewel-frontend"
          },
          "configurations": {
            "deploy": {
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.deploy.ts" }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "nbjewel-frontend:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
