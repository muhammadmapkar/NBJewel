# Role: Documents application environment settings read by the current code. Copy to .env
# and fill only the settings needed for your mode. Never put real secrets in this file.
# .env is ignored by git. Never place real API keys in frontend code or committed files.
# The .NET API reads these from its environment. Load them in the Terminal tab that starts
# the API with: set -a; source .env; set +a

# Chatbot (runs inside the .NET API). Backend environment only.
GEMINI_API_KEY=
GEMINI_MODEL=
# minimal, low, medium or high. Unset means low; empty uses the model default. Lower is faster.
GEMINI_THINKING_LEVEL=

# .NET API
# Sample (default) or Sql
Repository__Provider=
# Needed only when Repository__Provider is Sql. Backend environment only.
NBJEWEL_SQL_CONNECTION=

# Local SQL Server container (docker-compose.yml). Used only for Sql mode.
MSSQL_SA_PASSWORD=

# Virtual try-on (customer page /tryon, owner page /owner/jewelry). Backend environment only.
# Owner page PIN, 8 or more characters. Assumed, replace with real auth later. Never put it in the frontend.
OWNER_PIN=
# Comma separated allowed browser origins, for example https://your-app.vercel.app
# Empty allows http://localhost:4200 and http://localhost:4300.
CORS_ORIGINS=
# Folder for try-on jewelry metadata and images. Empty means backend/NbJewel.Api/App_Data/jewelry.
JEWELRY_STORAGE_PATH=

# ERP item preview uploads. Empty storage path uses backend/NbJewel.Api/App_Data/item-assets.
ITEM_ASSET_STORAGE_PATH=
# Unset means python3. Leave commented to preserve that default.
# CUTOUT_PYTHON_PATH=

# Frontend hosting build only (frontend npm run build:deploy). Public URL, never a secret.
# Unset/empty builds the frontend in sample mode. A configured API URL must use HTTPS.
NBJEWEL_API_URL=

# Optional identity/platform SQL settings. Keep UNSET for local sample work.
# Platform SQL falls back to NBJEWEL_IDENTITY_CONNECTION only when AI_PLATFORM_CONNECTION is unset.
# NBJEWEL_IDENTITY_CONNECTION=
# AI_PLATFORM_CONNECTION=
# Required outside Development: base64-encoded 32-byte secret plus platform SQL connection.
# An empty value is invalid; leave unset for ephemeral Development data protection.
# AI_DATA_PROTECTION_SECRET=
# Optional first ERP account bootstrap, used only with configured identity SQL.
# NBJEWEL_BOOTSTRAP_EMAIL=
# NBJEWEL_BOOTSTRAP_PASSWORD=

# Email verification (existing SMTP implementation, not needed for local sample staff).
# SMTP_HOST=
# SMTP_FROM=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# APP_PUBLIC_ORIGIN=
# SMTP_PORT defaults to 587. APP_PUBLIC_ORIGIN must be an HTTPS origin outside Development.
# Trusted proxy IP addresses, comma separated. Keep unset for local sample identity.
# TRUSTED_PROXIES=

# Local sample staff: prefer python3 scripts/run-sample-api.py, which generates a runtime password.
# Do not save that generated password here. These are .NET configuration overrides.
# SampleIdentity__Enabled=
# SampleIdentity__StaffPassword=
# AiSecurity__RequireEmailVerification=
# Standard .NET hosting settings (launchSettings.json supplies local defaults).
# ASPNETCORE_ENVIRONMENT=
# DOTNET_ENVIRONMENT=
# ASPNETCORE_URLS=

# Opt-in SQL integration test database only. Keep unset for sample-only tests.
# NBJEWEL_PLATFORM_TEST_CONNECTION=
