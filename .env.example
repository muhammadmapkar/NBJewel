# Role: Lists every environment variable name the project reads. Copy this file to .env
# and fill in the values. Names only here: never put a real value in this file.
# .env is ignored by git. Never place real API keys in frontend code or committed files.

# AI service (Python), backend only
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=
# Where the AI service finds the .NET API
NBJEWEL_API_URL=

# .NET API
# Sample (default) or Sql
Repository__Provider=
# Needed only when Repository__Provider is Sql. Backend environment only.
NBJEWEL_SQL_CONNECTION=
# Where the .NET API finds the AI service
AI_SERVICE_URL=

# Local SQL Server container (docker-compose.yml). Used only for Sql mode.
MSSQL_SA_PASSWORD=
